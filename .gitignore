# 构建产物（单二进制 ./aichat、测试与覆盖率文件）
/aichat
*.exe
*.test
*.out
/cover
cover.*

# 运行时数据：SQLite 库 / 媒体 / 备份，绝不进 git（05 §12）
/data/

# 本地配置覆盖：可能含密钥，绝不进 git（08 §2.8）
# 一条通配覆盖 config.local.yaml / models.local.yaml 等全部 *.local.yaml
/*.local.yaml

# 编辑器 / 系统
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# 日志
*.log

# 本地运维资产：只留本地，不上传 git
# _local/ 目录已清空，规则留着防再建；scripts/ 是四道闸与部署脚本，按约定不入库
_local/
/scripts/

# go.work 是本机把 QQ-SDK 的 sibling 目录接进构建用的，只对本机成立。
# CI 与别人 clone 下来的构建走 go.mod 里的 tag（v0.1.0），两边同源。
/go.work
/go.work.sum
